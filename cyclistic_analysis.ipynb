# 1. IMPORTACIÓN DE LIBRERÍAS
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from pathlib import Path

# Configuración de estilos visuales
sns.set_theme(style="whitegrid")
plt.rcParams['font.sans-serif'] = 'DejaVu Sans'

# 2. CARGA DE DATOS (Ruta relativa)
data_path = Path("data") / "202507-divvy-tripdata.csv"

# Fallback por si ejecutas el notebook dentro de la subcarpeta /notebooks
if not data_path.exists():
    data_path = Path("..") / "data" / "202507-divvy-tripdata.csv"

df = pd.read_csv(data_path)

print(f"Dimensiones iniciales del dataset: {df.shape[0]:,} filas y {df.shape[1]} columnas.")

# 3. TRANSFORMACIÓN E INGENIERÍA DE CARACTERÍSTICAS
df["started_at"] = pd.to_datetime(df["started_at"])
df["ended_at"] = pd.to_datetime(df["ended_at"])

# Duración del viaje en minutos
df["ride_length"] = (df["ended_at"] - df["started_at"]).dt.total_seconds() / 60

# Extracción de variables temporales
df["day_of_week"] = df["started_at"].dt.day_name()
df["month"] = df["started_at"].dt.month_name()
df["hour"] = df["started_at"].dt.hour

# 4. LIMPIEZA DE OUTLIERS Y ANOMALÍAS
# Se filtran viajes menores a 1 minuto (falsos inicios) o mayores a 24 horas (extravíos/mantenimiento)
df_clean = df[(df["ride_length"] >= 1) & (df["ride_length"] <= 1440)].copy()

print(f"Registros válidos tras remover anomalías: {df_clean.shape[0]:,} ({((len(df_clean)/len(df))*100):.2f}% conservado)")

# 5. ANÁLISIS DESCRIPTIVO
print("\n--- Duración Promedio del Viaje (Minutos) ---")
print(df_clean.groupby("member_casual")["ride_length"].mean().round(2))

print("\n--- Distribución Total de Viajes por Usuario ---")
print(df_clean["member_casual"].value_counts(normalize=True).mul(100).round(2).astype(str) + '%')

# 6. VISUALIZACIONES

# Gráfico 1: Número total de viajes por tipo de usuario
plt.figure(figsize=(6, 5))
count_trip = df_clean["member_casual"].value_counts()
ax = count_trip.plot(kind='bar', color=['#1f77b4', '#ff7f0e'], edgecolor='black')
plt.title("Total de Viajes por Tipo de Usuario", fontsize=13, fontweight='bold')
plt.xlabel("Tipo de Usuario")
plt.ylabel("Cantidad de Viajes")
plt.xticks(rotation=0)
for p in ax.patches:
    ax.annotate(f'{int(p.get_height()):,}', (p.get_x() + 0.12, p.get_height() * 0.5), color='white', fontweight='bold')
plt.tight_layout()
plt.show()

# Gráfico 2: Demanda por Día de la Semana (Cronológico)
orden_dias = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
viajes_dia = df_clean.groupby(["day_of_week", "member_casual"]).size().unstack().reindex(orden_dias)

viajes_dia.plot(kind="bar", figsize=(10, 5), color=['#ff7f0e', '#1f77b4'], edgecolor='black')
plt.title("Distribución de Viajes por Día de la Semana", fontsize=13, fontweight='bold')
plt.xlabel("Día de la Semana")
plt.ylabel("Cantidad de Viajes")
plt.xticks(rotation=45)
plt.legend(["Casual", "Member"])
plt.tight_layout()
plt.show()

# Gráfico 3: Demanda de Viajes por Hora del Día
viajes_hora = df_clean.groupby(["hour", "member_casual"]).size().reset_index(name="viajes")

plt.figure(figsize=(10, 5))
sns.lineplot(data=viajes_hora, x="hour", y="viajes", hue="member_casual", palette=['#ff7f0e', '#1f77b4'], linewidth=2.5, marker='o')
plt.title("Demanda de Viajes a lo Largo del Día (Horas Pico)", fontsize=13, fontweight='bold')
plt.xlabel("Hora del Día (0-23 hrs)")
plt.ylabel("Cantidad Total de Viajes")
plt.xticks(range(0, 24))
plt.tight_layout()
plt.show()

# Gráfico 4: Preferencia de Tipo de Bicicleta
plt.figure(figsize=(8, 5))
sns.countplot(data=df_clean, x="rideable_type", hue="member_casual", palette=['#ff7f0e', '#1f77b4'], edgecolor='black')
plt.title("Preferencia de Tipo de Bicicleta por Usuario", fontsize=13, fontweight='bold')
plt.xlabel("Tipo de Bicicleta")
plt.ylabel("Cantidad de Viajes")
plt.legend(["Casual", "Member"])
plt.tight_layout()
plt.show()

# Gráfico 5: Top 10 Estaciones de Inicio y Destino
df_estaciones = df_clean[['start_station_name', 'end_station_name']].dropna()
top_start = df_estaciones["start_station_name"].value_counts().head(10)
top_end = df_estaciones["end_station_name"].value_counts().head(10)

fig, axes = plt.subplots(nrows=1, ncols=2, figsize=(16, 6))

axes[0].barh(top_start.index, top_start.values, color='#1f77b4', edgecolor='black')
axes[0].set_title("Top 10 Estaciones de Inicio", fontsize=13, fontweight='bold')
axes[0].set_xlabel("Cantidad de Viajes")
axes[0].invert_yaxis()

axes[1].barh(top_end.index, top_end.values, color='#ff7f0e', edgecolor='black')
axes[1].set_title("Top 10 Estaciones de Destino", fontsize=13, fontweight='bold')
axes[1].set_xlabel("Cantidad de Viajes")
axes[1].invert_yaxis()

plt.tight_layout()
plt.show()
